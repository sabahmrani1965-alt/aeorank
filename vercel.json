{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/report/[brand]/page.js": {
      "maxDuration": 60
    },
    "app/api/contact/route.js": {
      "maxDuration": 10
    },
    "app/api/generate-report/route.js": {
      "maxDuration": 30
    },
    "app/api/cron/weekly-digest/route.js": {
      "maxDuration": 60
    },
    "app/api/cron/reengagement/route.js": {
      "maxDuration": 60
    },
    "app/api/cron/check-prompts/route.js": {
      "maxDuration": 280
    },
    "app/api/cron/refresh-mentions/route.js": {
      "maxDuration": 60
    },
    "app/api/admin/notify-posters/route.js": {
      "maxDuration": 60
    },
    "app/api/admin/notify-activated/route.js": {
      "maxDuration": 60
    },
    "app/api/cron/refresh-opportunities/route.js": {
      "maxDuration": 60
    },
    "app/api/free-check/route.js": {
      "maxDuration": 60
    },
    "app/api/cron/engine-health/route.js": {
      "maxDuration": 150
    },
    "app/api/cron/category-data/route.js": {
      "maxDuration": 280
    },
    "app/api/cron/weekly-ai-report/route.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/reengagement",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/check-prompts",
      "schedule": "0 9,21 * * *"
    },
    {
      "path": "/api/cron/refresh-mentions",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/refresh-opportunities",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/engine-health",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/category-data",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-ai-report",
      "schedule": "0 13 * * 1"
    }
  ]
}
