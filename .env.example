# Reddit data — needed in production because Reddit's public API blocks
# datacenter IPs (Vercel/AWS/GCP) with 403 Forbidden.
#
# Pick ONE of the following paths:
#
# Path A — Reddit OAuth (free, fast, best). Requires a "script" type app at
# https://www.reddit.com/prefs/apps. Reddit currently restricts new app
# creation for many accounts, so this isn't always possible.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
#
# Path B — Tavily Search API (recommended). Live Reddit data via web
# search. Free tier: 1,000 credits/month, no credit card required —
# at 2 credits per report (one brand search + one category search),
# that's ~500 reports/month free. Above that, paid plans start at $30/mo
# for 4,000 credits. Sign up at https://app.tavily.com
TAVILY_API_KEY=

# Path C — Apify (paid). Was the primary; now a fallback used only
# when Brave isn't configured or its quota is hit. Sign up at
# https://console.apify.com if you want it as a backup; safe to leave
# empty if you only want Brave.
APIFY_API_TOKEN=

# Required for the live LLM section in the report.
# Sign up at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model used. Defaults to claude-haiku-4-5 (cheap, fast).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Live AI-visibility check on the report page. Asks REAL buyer questions to
# live models and reports honestly whether the brand shows up.
#  - Gemini (2.0 flash + Google Search grounding): live web-grounded answers,
#    free tier from Google AI Studio — no credit card needed. Sign up at
#    https://aistudio.google.com/app/apikey
#  - Claude reuses ANTHROPIC_API_KEY above (model knowledge, no browsing).
# The section is hidden entirely if neither key is present (never faked).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ChatGPT + Perplexity coverage for the same live AI-visibility check,
# via Cloro's unified monitoring API (https://cloro.dev) — we have no
# direct OpenAI/Perplexity API key, so these two engines route through
# Cloro instead. Sign up at https://dashboard.cloro.dev/sign-up.
# Without this, the check just runs Gemini/Claude as before.
CLORO_API_KEY=

# Email — used for both contact-form leads AND the free-report email.
# Sign up at https://resend.com (free tier: 3,000 emails/mo, 100/day).
# Without these, leads are still logged but no email is sent.
RESEND_API_KEY=re_...
# Where you receive lead notifications (your inbox)
LEAD_EMAIL_TO=ilyas@aeorank.tech
# Sender — must be a verified domain on Resend.
# For initial testing, use: AEOrank <onboarding@resend.dev>
LEAD_EMAIL_FROM=AEOrank <leads@aeorank.tech>
# Resend Audience ID — every captured email (contact form, free report,
# Stripe checkout) is added to this audience so it shows up under
# https://resend.com/audiences. Get the ID from the URL of the audience
# page: https://resend.com/audiences/<this-uuid>
RESEND_AUDIENCE_ID=

# Optional — public site URL used in email links. Auto-detected from request
# host on Vercel, but set this explicitly for cleaner email links.
# NEXT_PUBLIC_SITE_URL=https://aeorank.tech

# CrewQuest → Discord — posts a message to this channel webhook every time a
# customer saves a new poster task (comment/reply/post/upvote order), so
# posters see new tasks in Discord as soon as they go live on /poster.
# Create one at: Discord server → channel Settings → Integrations →
# Webhooks → New Webhook → Copy Webhook URL. Without this, tasks still work
# normally — the Discord post is just skipped.
DISCORD_WEBHOOK_URL=

# Stripe — powers the Trial / Growth / Boost checkout buttons. Enterprise
# stays a contact form. Get your secret key at
# https://dashboard.stripe.com/apikeys (sk_test_... for testing,
# sk_live_... for production).
#
# Plan amounts and names are defined inline in lib/stripe.js, so no Stripe
# Products need to be pre-created — Stripe will auto-create one per
# checkout. Edit lib/stripe.js to change the prices.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — get this AFTER creating the webhook endpoint at
# https://dashboard.stripe.com/webhooks (URL: /api/webhooks/stripe). Select
# these events: checkout.session.completed, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed. Stripe shows the
# whsec_... value in the endpoint's "Signing secret" reveal.
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — customer accounts + dashboard (login, report history, saved
# Reddit-post drafts, plan/billing status). Create a project at
# https://supabase.com, then paste supabase/schema.sql into the SQL editor
# (Settings → SQL Editor) and run it. Under Authentication → URL
# Configuration, add {NEXT_PUBLIC_SITE_URL}/auth/callback as a redirect URL
# (e.g. http://localhost:3001/auth/callback for local dev) or magic links
# will be rejected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses Row Level Security. Used only by
# the Stripe webhook to provision accounts and write subscription status.
# NEVER expose this to the browser. Get it from Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin) — comma-separated allowlist of emails that can
# access it. Anyone else logged in gets redirected to their own /dashboard.
ADMIN_EMAILS=you@example.com
